[Unit]
Description=Persistent desktop system tray registry
PartOf=graphical-session.target
After=graphical-session.target
Before=quickshell-desktop.service

[Service]
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell/tray-watcher
ExecStartPost=%h/.local/bin/quickshell-tray-registry restore
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
