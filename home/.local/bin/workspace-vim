#!/usr/bin/env python3
"""Navigate the desktop's five numbered workspaces without wrapping."""
import json
import subprocess
import sys

if len(sys.argv) != 2 or sys.argv[1] not in ('left', 'right', 'first', 'last'):
    raise SystemExit(2)
action = sys.argv[1]
if action in ('first', 'last'):
    target = 1 if action == 'first' else 5
else:
    current = json.loads(subprocess.check_output(['hyprctl', '-j', 'activeworkspace'], timeout=2))['id']
    target = max(1, min(5, current + (-1 if action == 'left' else 1)))
subprocess.run(['hyprctl', 'dispatch', f'hl.dsp.focus({{ workspace = {target} }})'], check=True)
