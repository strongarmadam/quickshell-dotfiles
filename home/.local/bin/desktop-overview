#!/usr/bin/env python3
"""Compatibility entry point for the standalone Quickshell overview."""
import os
from pathlib import Path
import shutil
import sys

HOME = Path.home()

def available():
    return bool(shutil.which('quickshell')) and all((HOME / p).is_file() for p in (
        '.local/bin/workspace-overview', '.config/quickshell/overview/shell.qml',
        '.config/quickshell/overview/backend.py', '.config/quickshell/keybindings/backend.py'))

if __name__ == '__main__':
    if '--check' in sys.argv or '--build' in sys.argv:
        print('Overview ready; no native plugin build required.' if available() else 'Rerun setup and install Quickshell.')
        raise SystemExit(0 if available() else 1)
    os.execv(str(HOME/'.local/bin/workspace-overview'), ['workspace-overview'])
