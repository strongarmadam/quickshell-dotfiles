#!/usr/bin/env python3
"""Run a user-selected application using argv, never an interpolated shell command."""
import json,os,subprocess,sys
from pathlib import Path
try:
    choices=json.loads((Path.home()/'.config/desktop-apps.json').read_text())
    role=sys.argv[1];args=sys.argv[2:]
    if role=='terminal-exec':command=choices['terminal']+choices['terminal_exec']+args
    else:command=choices[role]+args
    os.execvp(command[0],command)
except (KeyError,IndexError,OSError,ValueError) as e:
    subprocess.run(['notify-send','Application unavailable',str(e)],check=False)
    print(str(e),file=sys.stderr);sys.exit(1)
