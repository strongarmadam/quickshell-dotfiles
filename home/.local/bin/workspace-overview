#!/bin/bash
set -euo pipefail
config="$HOME/.config/quickshell/overview"
# Serialize repeated shortcut presses, including startup before IPC is ready.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/workspace-overview-$UID.lock"
flock -w 3 9 || exit 0
if quickshell ipc -p "$config" call overview toggle >/dev/null 2>&1; then exit 0; fi
quickshell -n -p "$config" >/dev/null 2>&1 9>&- &
for attempt in {1..30}; do
    if quickshell ipc -p "$config" call overview state >/dev/null 2>&1; then exit 0; fi
    sleep 0.05
done
notify-send 'Workspace overview' 'Could not start the overview. Check the Quickshell logs.'
