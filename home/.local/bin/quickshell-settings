#!/bin/bash
set -euo pipefail
config="$HOME/.config/quickshell/settings-editor"
action="${1:-show}"
case "$action" in show|creator) ;; *) echo "Usage: quickshell-settings [creator]" >&2; exit 2 ;; esac
if quickshell ipc -p "$config" call settingsEditor "$action" 2>/dev/null; then exit 0; fi
exec env QUICKSHELL_SETTINGS_PAGE="$action" quickshell -n -p "$config"
