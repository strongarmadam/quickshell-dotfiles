#!/bin/bash
set -euo pipefail
# Blueman supplies BlueZ PIN/passkey and confirmation dialogs.
if ! pgrep -u "$(id -u)" -f '^/usr/bin/python.* /usr/bin/blueman-applet|^/usr/bin/blueman-applet' >/dev/null; then
    blueman-applet >/dev/null 2>&1 &
fi
config="$HOME/.config/quickshell/bluetooth"
if quickshell ipc -p "$config" call bluetooth toggle 2>/dev/null; then exit 0; fi
exec quickshell -n -p "$config"
